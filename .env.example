# Copy to .env and replace with a private random value (32+ characters).
OPERATOR_TOKEN=replace-this-with-a-random-secret-at-least-32-characters
COLLECTOR_TOKEN=replace-this-with-another-random-secret-at-least-32-characters
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Keep chat_completions for existing providers; select responses only after provider verification.
MODEL_WIRE_API=chat_completions
# Optional reasoning effort for either protocol; no automatic fallback or retry.
# MODEL_REASONING_EFFORT=low
EXTERNAL_MODEL_ENABLED=false
MODEL_JSON_SUPPORTED=true
MODEL_VISION_SUPPORTED=false
MODEL_CONTEXT_WINDOW=32768
MODEL_MAX_OUTPUT_TOKENS=1500
INITIAL_INPUT_TOKENS=8000
INVESTIGATION_INPUT_TOKENS=12000
INITIAL_MODEL_CALLS=6
INVESTIGATION_MODEL_ROUNDS=8
INVESTIGATION_TOOL_CALLS=20
BUDGET_TOTAL_TOKENS=100000
CODE_SEARCH_LIMIT=20
# Leave costs empty when provider prices are unknown (no fabricated bills).
# MODEL_INPUT_COST_PER_MILLION=
# MODEL_OUTPUT_COST_PER_MILLION=
DATABASE_PATH=./data/runtime.sqlite3
ARTIFACT_ROOT=./data/artifacts
REPOSITORY_ROOTS=./demo,./targets
SSH_ENABLED=false
SSH_CREDENTIALS={}
# SSH_CREDENTIALS maps references to operator-owned key FILE paths, never private key contents.
UPLOAD_MAX_BYTES=52428800
EXTRACTION_MAX_BYTES=209715200
ARTIFACT_MAX_FILES=2000
ARTIFACT_MAX_FILE_BYTES=20971520
ARTIFACT_READ_BYTES=262144
ARTIFACT_MAX_DEPTH=16
EXTRACTION_TIMEOUT_SECONDS=45
ALLOWED_HEALTH_URLS=http://edge_proxy/health,http://ingress_proxy/health
# Optional write-once target repositories below this directory are mounted read-only.
TARGETS_PATH=./targets
# Linux / Docker Desktop (WSL2) Docker Engine socket. Keep the collector private.
DOCKER_SOCKET_PATH=/var/run/docker.sock
